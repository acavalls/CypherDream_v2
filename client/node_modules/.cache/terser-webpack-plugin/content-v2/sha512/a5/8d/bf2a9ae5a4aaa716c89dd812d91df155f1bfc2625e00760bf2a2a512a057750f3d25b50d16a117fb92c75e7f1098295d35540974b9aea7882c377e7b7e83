ong> </button>\\n            </div>\\n            \\n        </div>\\n        \\n    </article>\\n);\\n\\nexport default searchResults;\",\"import React from 'react';\\n\\nimport classes from './Loading.module.css';\\n\\nconst spinner = () => (\\n    <div className={classes.Loader}> \\n        <div className={classes.Text}> Loading... </div> \\n    </div>\\n);\\n\\nexport default spinner;\",\"import React from 'react';\\nimport classes from './Checkbox.module.css';\\n\\nconst checkbox = (props) => {\\n    return (\\n    <React.Fragment>\\n\\n        <input \\n             className={classes.checkmark}\\n             type=\\\"checkbox\\\"\\n             name=\\\"¿Allow partial matching?\\\"\\n             checked={props.isChecked}\\n             onChange={props.clicked} />\\n\\n    </React.Fragment>\\n    )\\n}\\n\\nexport default checkbox;\",\"import React, { Component } from 'react';\\nimport classes from './GenomicsForm.module.css';\\nimport Input from '../../components/UI/Input/Input';\\nimport axios from './../../axios-orders';\\nimport SearchResults from '../../components/SearchResults/SearchResults';\\nimport Loading from '../../components/UI/Loading/Loading';\\nimport Backdrop from '../../components/UI/Backdrop/Backdrop';\\nimport Checkbox from '../../components/UI/Checkbox/Checkbox';\\nimport Transaction from 'ethereumjs-tx';\\nimport ethJsUtil from 'ethereumjs-util';\\n\\n//import IndexDB from '../IndexDB/IndexDB';\\n\\nclass GenomicsForm extends Component {\\n\\n    state = {\\n        searchForm: {\\n            Address: {\\n                elementType: 'input',\\n                elementConfig: {\\n                    type: 'text',\\n                    placeholder: 'Type an ERC20 public address: 0xbc....'\\n                },\\n                value: '',\\n                displayBox: false\\n            },\\n            Age: {\\n                elementType: 'input',\\n                elementConfig: {\\n                    type: 'text',\\n                